<?xml version="1.0" encoding="UTF-8"?>
<scxml xmlns="http://www.w3.org/2005/07/scxml" version="1.0" datamodel="ecmascript" name="preview-demo" initial="idle">
  <datamodel>
    <data id="count" expr="0"/>
  </datamodel>
  <state id="idle">
    <transition event="start" target="running">
      <assign location="count" expr="count + 1"/>
    </transition>
  </state>
  <state id="running">
    <transition event="stop" target="idle"/>
    <transition event="finish" target="done"/>
  </state>
  <final id="done">
    <donedata><content expr="count"/></donedata>
  </final>
</scxml>
