{
  "name": "statechart-kit",
  "version": "0.7.3",
  "description": "Statechart authoring model, editor and session runner. Produces and drives SCXML; it does not interpret SCXML.",
  "license": "MIT",
  "type": "module",
  "sideEffects": [
    "./dist/vue.js",
    "**/*.css"
  ],
  "keywords": [
    "statechart",
    "state chart",
    "state machine",
    "scxml",
    "harel",
    "fsm",
    "editor"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./engine": {
      "types": "./dist/engine.d.ts",
      "import": "./dist/engine.js"
    },
    "./package.json": "./package.json",
    "./vue": {
      "types": "./dist/vue-types/vue/index.d.ts",
      "import": "./dist/vue.js"
    },
    "./vue/style.css": "./dist/vue/style.css",
    "./diagnostics/zh": {
      "types": "./dist/diagnostics/zh.d.ts",
      "import": "./dist/diagnostics/zh.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "npm run build:core && npm run build:vue",
    "typecheck": "tsc --noEmit && vue-tsc --noEmit -p tsconfig.vue.json",
    "test": "npm run test:import && npm run test:smoke && npm run test:timers && npm run test:naming && npm run test:events && npm run test:validation && npm run test:engine && npm run test:editor",
    "test:import": "tsx test/verify-import.ts",
    "test:smoke": "tsx test/smoke-engine.ts",
    "test:timers": "tsx test/verify-timers.ts",
    "test:naming": "tsx test/verify-naming.ts",
    "test:events": "tsx test/verify-events.ts",
    "test:validation": "tsx test/verify-validation.ts",
    "test:engine": "tsx test/verify-engine.ts",
    "freeze:baseline": "node scripts/freeze-baseline.mjs",
    "check:baseline": "node scripts/check-baseline.mjs",
    "check:pack": "node scripts/check-pack.mjs",
    "verify:all": "npm run typecheck && npm test && npm run build && npm run check:baseline && npm run check:vue && npm run check:pack",
    "prepack": "npm run build",
    "build:core": "tsup",
    "build:vue": "vite build && vue-tsc -p tsconfig.vue-dts.json",
    "check:vue": "node scripts/check-vue.mjs",
    "test:editor": "tsx test/verify-editor.ts",
    "prepublishOnly": "npm run verify:all"
  },
  "dependencies": {
    "@tinyactors/scxmljs": "0.2.0-dev.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@vitejs/plugin-vue": "^6.0.10",
    "happy-dom": "^21.0.4",
    "tsup": "^8.5.0",
    "tsx": "^4.23.15",
    "typescript": "^5.9.0",
    "vite": "^7.3.8",
    "vue": "^3.5.45",
    "vue-tsc": "^3.3.14"
  },
  "peerDependencies": {
    "vue": "^3.5.13"
  },
  "peerDependenciesMeta": {
    "vue": {
      "optional": true
    }
  },
  "publishConfig": {
    "access": "public"
  }
}
